# ============================================================
# 社内ナレッジ検索ボット — 環境変数テンプレート
# 使い方: cp .env.example .env  → 必要な値を埋める
# 機密値（API キー、パスワード、暗号化キー）は絶対に Git に commit しないこと
# ============================================================

# ===== Application =====
APP_NAME="社内ナレッジ検索ボット"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.0.3:8080
APP_TIMEZONE=Asia/Tokyo

# ===== Database (MariaDB / MySQL) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rag_chatbot
DB_USER=root
DB_PASSWORD=

# ============================================================
# LLM プロバイダ設定
#   3つのクラウドLLM API に対応（管理画面 admin/settings.php からも動的変更可）。
#   使うプロバイダのコメントを外し、LLM_PROVIDER をその名前に合わせる。
#   ★ API キーの値は空欄。運用者が各自で発行して記入すること（Git に commit 禁止）。
# ============================================================

# 使用するプロバイダ: gemini / openai / anthropic
LLM_PROVIDER=gemini

# LLMへのHTTPタイムアウト秒。クラウドLLMなら120程度で十分。
LLM_HTTP_TIMEOUT=120

# ----- (1) Google Gemini … ★検証用（無料枠あり・現在の稼働構成） -----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 複数キーで自動フェイルオーバー（ラウンドロビン）。GEMINI_API_KEY=1本目, _2=2本目, _3=3本目…（or GEMINI_API_KEYS=k1,k2,k3）。
# 挙動: 1→2→3→1… の順に使い、あるキーが 429(上限)/401・403(権限)/無効キー/5xx/接続不可 で「だめ」なら
#       そのキーを短時間クールダウンして次のキーへ自動で回す。全キーを一周して全滅したときだけエラーを返す。
#       成功したキーの「次」から始めるので負荷は全キーへ分散する。1本だけでも従来どおり動作。
# ※400(不正リクエスト)/404(モデル無し)等はどのキーでも同じ結果なので回さず即エラー（真因を隠さないため）。
# ★本番は「課金を有効にした有料枠」のキーを使うこと。有料枠は入出力を学習に使われない（無料枠は学習・人間レビュー対象）。
#   有料キーを複数入れるのは冗長化・上限緩和として正当。無料枠の複数アカウント分散はToS上グレー＝検証時のみ。
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ★モデル名は「そのままAPIへ渡す自由指定」。下の例は既定/目安で、最新モデルに差し替え可。
#   使う時は LLM_PROVIDER をそのプロバイダ名にし、そのプロバイダのキー＋MODELを設定するだけ。

# ----- (2) OpenAI … LLM_PROVIDER=openai -----
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini          # 例: gpt-4o-mini（安価）/ gpt-4o / 最新の gpt-5 系 等、任意に指定可

# ----- (3) Anthropic Claude … LLM_PROVIDER=anthropic -----
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-5   # 例: claude-haiku-4-5（安）/ claude-sonnet-5（標準）/ claude-opus-4-8（高精度）

# ----- （参考）その他の対応プロバイダ。必要なら解除して使う -----
# Groq（OpenAI互換・クラウド）
#GROQ_API_KEY=
#GROQ_MODEL=llama-3.3-70b-versatile
# ローカルLLM（Ollama / LM Studio / vLLM、OpenAI互換）… 外部送信ゼロ
#OLLAMA_BASE_URL=http://localhost:11434/v1   # LM Studioは :1234/v1
#OLLAMA_API_KEY=ollama
#OLLAMA_MODEL=llama3.2:latest      # ローカルに入れた任意モデル名（qwen等でも可）

# ============================================================
# Embedding Provider 設定（ベクトル検索用）
#   設定すると、キーワード検索に加えて「DB内ベクトル検索（コサイン類似度）」が
#   有効になり、Hybrid検索（RRF統合）になる。外部ベクトルDBは不要。
#   none にするとキーワード検索のみで縮退（完全動作するが精度は落ちる）。
#
#   ★クラウド既定 = gemini（LLMと同じ GEMINI_API_KEY を流用・無料枠あり）
#   ※ プロバイダ/モデルを変更したら scripts/backfill_embeddings.php --all で
#     既存チャンクを再ベクトル化すること（次元が変わるため）。
# ============================================================
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 他プロバイダを使う場合のモデル（使うものだけコメント解除）
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#VOYAGE_API_KEY=
#VOYAGE_MODEL=voyage-3.5-lite
# ローカル完結（Ollama/LM Studio）で埋め込みもローカルにする場合:
#OLLAMA_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# DB内ベクトル検索の総当り候補上限（安全弁）。大規模ナレッジでは引き上げる。
RAG_VECTOR_MAX_CANDIDATES=5000

# ============================================================
# 外部ベクトルDB (Qdrant) — 任意。大規模化した場合のみ。
#   未設定なら上記のDB内ベクトル検索を使用（既定・外部不要）。
# ============================================================
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

# ============================================================
# Reranker（任意）
# ============================================================
RERANK_PROVIDER=none
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ============================================================
# Admin Auth（顧客専用ログイン）
# ★ サーバへ配置後、必ず強いパスワードに再生成すること
#    生成例（PHP CLI で）:
#    php -r "echo password_hash('your-strong-password', PASSWORD_DEFAULT), PHP_EOL;"
#
#  この /admin/ は「顧客専用」。トークン/コスト/LLM設定などベンダー内部情報は一切表示しない。
#  ベンダーはここにログインせず、統括コンソール(vendor_console)で全顧客を管理する。
#  LLM/プロバイダ/モデル/キーは上の LLM_* / *_MODEL（.env）で設定（管理画面UIは無し）。
# ============================================================
# 顧客用ログイン（顧客ロール）。★空のままにする → お客様が setup-password.php で自分で設定する。
# 未設定の間は誰もログインできない（安全側）。ウィザードで設定されると顧客がログイン可能に。
CUSTOMER_USERNAME=
CUSTOMER_PASSWORD_HASH=
# （ADMIN_* / ベンダーロールは廃止。この画面にベンダーはログインしない）

# ============================================================
# 暗号化キー（APIキー等を AES-256-GCM で暗号化してDB保存する用）
# ★ サーバごとに新規生成すること（盗まれてもDBデータ復号不可にする）
#    生成例（PHP CLI で）:
#    php -r "echo 'base64:', base64_encode(random_bytes(32)), PHP_EOL;"
# ============================================================
APP_ENCRYPTION_KEY=

# ============================================================
# RAG Settings
# ============================================================
RAG_TOP_K_RETRIEVE=50
RAG_TOP_K_RERANK=5
RAG_CONFIDENCE_THRESHOLD=0.3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_CITATIONS_ENABLED=true

# 全文書RAG（parent-document retrieval）
# 検索でヒットした文書を「丸ごと」LLMへ渡す。チャンク断片より文脈が切れず精度が上がる。
# 0/false で従来のチャンク単位に戻す。
RAG_FULLDOC_ENABLED=1
# 文脈に含める文書数の上限（関連度上位から）
RAG_FULLDOC_MAX_DOCS=3
# 文脈全体の文字数上限。LLMのコンテキスト長に合わせて調整すること。
# 例: LM Studioでコンテキスト32Kなら24000程度、8Kなら4000程度に下げる。
RAG_CONTEXT_MAX_CHARS=24000

# ============================================================
# Guardrails — 社内ナレッジ運用向け
# ============================================================
GUARD_TOPIC_DESCRIPTION="社内文書（規定、手順書、FAQ、過去議事録など）に関する質問にのみ回答します。社内文書に含まれない一般的な雑談や個人情報の取扱いは行いません。"
GUARD_ENABLED=true

# 拒否文（対象外の質問）に差し込む短い対象範囲ラベル（名詞句）。
#   例: 社内規程・人事制度 / 当サービス / 貸与PCの利用
#   未設定なら分野名を出さない中立文になる（どの業界でも成立）。
GUARD_TOPIC_LABEL=

# 標準チャット /chat/ のアクセス鍵（顧客のブックマークURL ?k= 用）。空なら制限なし。埋め込み(?embed=1)は対象外。
CHAT_ACCESS_KEY=

# ============================================================
# トークン上限（ベンダー管理・保守プラン別）
#   月間の消費トークンがこの値に達したら、以降の回答を停止（LLMを呼ばない）。
#   0/空 = 無制限。保守プランに応じて数値を設定（例: 3500000）。顧客/お客様からは不可視。
#   MONTHLY_TOKEN_COST_PER_1M: 100万トークンあたりの円。設定するとベンダー画面に推定コスト表示。
# ============================================================
MONTHLY_TOKEN_LIMIT=
MONTHLY_TOKEN_COST_PER_1M=

# ============================================================
# サービス稼働フラグ（キルスイッチ・ベンダー管理）
#   通常の停止/再開は「統括コンソールのボタン」＝DBの service_active を切り替える運用。
#   ここの SERVICE_ACTIVE は “強制停止の上書き”（ハードロック）:
#     1 = DB設定に従う（既定）／ 0 = DBが何であれ強制停止。
#   停止中はLLMを呼ばず中立メッセージだけ返す。DB/ナレッジは消さないので可逆。
#   SERVICE_SUSPENDED_MESSAGE: 停止中の表示文（空なら安全な既定文）。
#     ※顧客サイトの訪問者(第三者)が見る前提。「未払い」等は書かない中立文にすること。
# ============================================================
SERVICE_ACTIVE=1
SERVICE_SUSPENDED_MESSAGE=
